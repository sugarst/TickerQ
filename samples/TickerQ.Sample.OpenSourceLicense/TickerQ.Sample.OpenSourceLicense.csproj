<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.15" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.13" />
    <PackageReference Include="NSec.Cryptography" Version="26.4.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TickerQOpenSourceRoot)' != ''">
    <ProjectReference Include="$(TickerQOpenSourceRoot)/src/TickerQ/TickerQ.csproj" />
    <ProjectReference Include="$(TickerQOpenSourceRoot)/src/TickerQ.Dashboard/TickerQ.Dashboard.csproj" />
    <ProjectReference Include="$(TickerQOpenSourceRoot)/src/TickerQ.EntityFrameworkCore/TickerQ.EntityFrameworkCore.csproj" />
    <Compile Include="$(TickerQOpenSourceRoot)/samples/TickerQ.Sample.WebApi/Migrations/*.cs" Link="Migrations/%(Filename)%(Extension)" />
  </ItemGroup>
  <Target Name="ValidateSnapshotPath" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(TickerQOpenSourceRoot)/LICENSE') Or !Exists('$(TickerQOpenSourceRoot)/src/TickerQ/TickerQ.csproj')"
           Text="Set TickerQOpenSourceRoot to the extracted b2aefd0932c97d13358c4def46cb5eba92c9b399 source archive." />
  </Target>
</Project>

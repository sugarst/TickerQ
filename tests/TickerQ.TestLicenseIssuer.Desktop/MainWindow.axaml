<atom:Window xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:atom="https://atomui.net"
             xmlns:local="using:TickerQ.TestLicenseIssuer.Desktop"
             x:Class="TickerQ.TestLicenseIssuer.Desktop.MainWindow"
             Width="600" MinWidth="460" SizeToContent="Height"
             WindowStartupLocation="CenterScreen">
    <atom:Window.Styles>
        <Style Selector="Border.certificate-card">
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="20,18" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172B46" />
        </Style>
        <Style Selector="TextBlock.description">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#4D6179" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </atom:Window.Styles>

    <ScrollViewer Background="#F2F5FA" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="660" Margin="22,20,22,22" Spacing="14">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="2,0,2,6">
                <TextBlock x:Name="PageTitle" FontSize="25" FontWeight="SemiBold" Foreground="#122744"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                    <TextBlock x:Name="LanguageLabel" FontSize="13" Foreground="#4D6179" VerticalAlignment="Center" />
                    <atom:ComboBox x:Name="LanguagePicker" Width="120" />
                </StackPanel>
            </Grid>

            <Border Classes="certificate-card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="ServiceHeading" Classes="section-title" />
                        <TextBlock x:Name="ServiceDescription" Classes="description" />
                    </StackPanel>
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                        <atom:Button x:Name="PortalButton" Click="OpenPortalAsync" />
                        <atom:Button x:Name="ServiceExportButton" Click="ExportServiceCertificateAsync" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="certificate-card">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="5">
                        <TextBlock x:Name="TestHeading" Classes="section-title" />
                        <TextBlock x:Name="TestDescription" Classes="description" />
                    </StackPanel>

                    <Border Padding="14,12" CornerRadius="10" Background="#F2F6FD"
                            BorderBrush="#E0E9F6" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock x:Name="ExpirationLabel" FontSize="13" FontWeight="SemiBold" Foreground="#334E70" />
                            <WrapPanel Orientation="Horizontal" ItemSpacing="12" LineSpacing="8">
                                <local:SelectionDatePicker x:Name="ExpirationPicker" Width="176"
                                                           IsShowTime="True" ClockIdentifier="HourClock24"
                                                           IsNeedConfirm="True" IsShowNow="False" />
                                <atom:Button x:Name="TestExportButton" ButtonType="Primary"
                                             VerticalAlignment="Center" Click="ExportTestCertificateAsync" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="TestExportResult" IsVisible="False" Padding="14,12" CornerRadius="10"
                            BorderThickness="1" BorderBrush="#CDE5D4" Background="#F3FAF5"
                            TextElement.Foreground="#25362E">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="#25834F" VerticalAlignment="Center" />
                                    <TextBlock x:Name="TestExportTitle" Grid.Column="1" TextWrapping="Wrap"
                                               FontWeight="SemiBold" Foreground="#185C36" />
                                </Grid>
                                <atom:Button x:Name="OpenExportFolderButton" Grid.Column="1" Click="OpenExportFolderAsync" />
                            </Grid>
                            <Border Height="1" Background="#DCEBE0" />
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="18" RowSpacing="5"
                                  TextElement.FontSize="13">
                                <TextBlock x:Name="BeijingResultLabel" Foreground="#4A6054" />
                                <SelectableTextBlock x:Name="BeijingResultValue" Grid.Column="1" />
                                <TextBlock x:Name="UtcResultLabel" Grid.Row="1" Foreground="#4A6054" />
                                <SelectableTextBlock x:Name="UtcResultValue" Grid.Row="1" Grid.Column="1" />
                            </Grid>
                            <TextBlock x:Name="OpenExportFolderError" IsVisible="False" TextWrapping="Wrap" FontSize="12"
                                       Foreground="#8A4025" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border x:Name="ExportStatusPanel" Classes="certificate-card" IsVisible="False">
                <SelectableTextBlock x:Name="ExportStatus" Foreground="#334E70" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</atom:Window>
